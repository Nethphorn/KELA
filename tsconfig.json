{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "declaration": true,
    "outDir": "dist",
    "lib": ["esnext", "dom"],
    "jsx": "react-jsx",
    "typeRoots": ["node_modules/@types"],
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "playwright-tests/**/*",
    "*.config.js",
    "*.config.cjs",
    "*.config.ts"
  ],
  "exclude": [
    "eslint.config.ts",
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/ui",
    "src/styles"
  ]
}
